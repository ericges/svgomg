<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="Content-Security-Policy" content="default-src 'none'; base-uri 'none'; form-action 'none'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; manifest-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; frame-src 'self' data:">
        <title>{{ title }}</title>
        <meta name="theme-color" content="#2b2d30">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="preload" crossorigin as="font" href="fonts/JetBrainsMonoNL/JetBrainsMonoNL-Regular-latin.woff2">
        <link rel="manifest" href="manifest.json">
        <link rel="apple-touch-icon" href="{{ iconPath }}">
        <link rel="icon" href="{{ iconPath }}">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="application-name" content="OMSVG">
        <meta name="twitter:card" content="summary">
        <meta name="description" content="{{ description }}">
        <meta property="og:description" content="{{ description }}">
        <meta property="og:image" content="{{ liveBaseUrl }}{{ iconPath }}">
        <meta property="og:title" content="{{ title }}">
        <script src="js/page.js" defer></script>
        <style>{{ headCSS|safe }}</style>
        <!-- Swapped to rel=stylesheet by page.js; see src/js/page/index.js. -->
        <link rel="preload" as="style" href="all.css">
    </head>
    <body>
        <div class="app-output">
            <header class="toolbar">
                <div class="toolbar-brand">
                    {% include "partials/icons/logo.svg" %}
                    <div class="toolbar-brand-copy">
                        <h1>OMSVG</h1>
                        <p>
                            {% include "partials/icons/bolt.svg" %}
                            <span class="powered-by">Powered by</span>
                            <a href="https://github.com/svg/svgo">SVGO v{{ SVGO_VERSION }}</a>
                        </p>
                    </div>
                </div>
                <div class="toolbar-actions">
                    <button class="load-file unbutton toolbar-action toolbar-action-primary" type="button" title="Open an SVG file">
                        {% include "partials/icons/open.svg" %}
                        <span class="toolbar-action-text">Open SVG</span>
                    </button>
                    <label class="toolbar-action toolbar-paste" title="Paste SVG markup">
                        {% include "partials/icons/paste.svg" %}
                        <span class="input-area">
                            <textarea class="paste-input" aria-label="Paste markup" spellcheck="false" autocomplete="off"></textarea>
                            <span class="toolbar-action-text label-txt">Paste markup</span>
                        </span>
                    </label>
                    <div class="toolbar-demo">
                        <button class="load-demo unbutton toolbar-action toolbar-action-split" type="button" title="Load the {{ demos[0].name }} demo" data-demo-file="{{ demos[0].file }}">
                            {% include "partials/icons/demo.svg" %}
                            <span class="toolbar-action-text">Demo</span>
                        </button>
                        <button class="demo-menu-btn unbutton toolbar-action toolbar-action-caret" type="button" title="Pick a demo SVG" aria-label="Pick a demo SVG" aria-haspopup="true" aria-expanded="false" popovertarget="demo-menu">
                            {% include "partials/icons/caret.svg" %}
                        </button>
                        <ul class="demo-menu" id="demo-menu" popover>
                            {% for demo in demos %}
                                <li>
                                    <button class="demo-menu-item unbutton" type="button" data-demo-file="{{ demo.file }}">{{ demo.name }}</button>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                <div class="toolbar-output-nav">
                    <form class="view-toggler">
                        <label class="view-toggler-tab" title="Show the image">
                            <input type="radio" name="output" value="image" checked>
                            <span class="selected"></span>
                            {% include "partials/icons/preview.svg" %}
                            <span class="toolbar-action-text">Preview</span>
                        </label>
                        <label class="view-toggler-tab" title="Show the markup">
                            <input type="radio" name="output" value="code">
                            <span class="selected"></span>
                            {% include "partials/icons/markup.svg" %}
                            <span class="toolbar-action-text">Markup</span>
                        </label>
                    </form>
                </div>
                <span class="toolbar-nav-divider" aria-hidden="true"></span>
                <a href="https://github.com/ericges/omsvg" class="toolbar-action toolbar-link" title="Source and contributions on GitHub">
                    {% include "partials/icons/contribute.svg" %}
                    <span class="toolbar-action-text">Source</span>
                </a>
                <input type="file" class="load-file-input" accept=".svg" hidden>
            </header>
            <div class="main">
                {# The app opens with no file, so this sheet is what's below the bar
                   at first paint. It's the first child of `.main` because the CSS
                   hides the settings panel and the action buttons off its `active`
                   class with sibling selectors; `EmptyState` drops that class — and
                   the sheet — on the first load. #}
                <div class="empty-state active">
                    <div class="empty-state-card">
                        {% include "partials/icons/open.svg" %}
                        <h2>Open an SVG</h2>
                        <p>Drop a file anywhere on this page, pick one with <span class="nowrap"><b>Open SVG</b> (<kbd>Ctrl</kbd> + <kbd>O</kbd>)</span>, or paste markup into the toolbar.</p>
                        <p>No file to hand? Load a <b>Demo</b>.</p>
                        <p class="empty-state-note">Nothing is uploaded — your file never leaves this browser.</p>
                        {# § 2(c) of the licence asks the app itself to say where the source is,
                           and MIT and Blue Oak ask that the bundled notices reach whoever gets a
                           copy. Both pages are built from the markdown in the repository root. #}
                        <p class="empty-state-legal"><a href="notices.html">Licence and notices</a></p>
                    </div>
                </div>
                <div class="output">
                    {# Outside the `.output-switcher` subtree on purpose: `PanZoom` takes
                       its event area from `SvgOutput`'s own container, so a control that
                       isn't a descendant of it can't be swallowed by a pan gesture.
                       `ViewMode`'s container is appended in here. #}
                    <div class="view-mode-container"></div>
                    <div class="action-button-container">
                        <div class="minor-action-container"></div>
                        <div class="results-container"></div>
                    </div>
                </div>
                <div class="settings">
                    {% macro pluginToggle(plugin) %}
                        <label class="setting-item-toggle">
                            <input type="checkbox" name="{{ plugin.id }}" {% if plugin.enabledByDefault %}checked{% endif %}>
                            {% include "partials/material-switch.html" %}
                            <span class="setting-item-lines">
                                <span class="setting-item-name">{{ plugin.name }}</span>
                                {# The SVGO plugin id, so the panel says which plugin a
                                   control really is — it's what the docs and the CLI call it. #}
                                <code class="setting-item-id">{{ plugin.id }}</code>
                            </span>
                        </label>
                    {% endmacro %}
                    <div class="results-container-mobile"></div>
                    {# Outside `.settings-scroller` on purpose: the scroller's `mousedown`
                       handler cancels focus for everything that isn't a non-checkbox
                       control, which would leave these buttons unfocusable. #}
                    <div class="settings-tabs" role="tablist" aria-label="Settings">
                        <button type="button" class="unbutton settings-tab" role="tab" id="settings-tab-optimise" aria-controls="settings-panel-optimise" aria-selected="true">Optimise</button>
                        <button type="button" class="unbutton settings-tab" role="tab" id="settings-tab-output" aria-controls="settings-panel-output" aria-selected="false" tabindex="-1">Output</button>
                    </div>
                    <div class="settings-scroller">
                        <div class="settings-panel" role="tabpanel" id="settings-panel-optimise" aria-labelledby="settings-tab-optimise">
                            <section>
                                <label class="setting-item-toggle">
                                    <input type="checkbox" name="multipass">
                                    {% include "partials/material-switch.html" %}
                                    Multipass
                                </label>
                                {# No `name`, deliberately: a named control would land in
                                   `_globalInputs`, and so in the settings object and the cache
                                   fingerprint. Filtering is a view concern — it hides rows, it
                                   never changes what is enabled. #}
                                <div class="setting-filter">
                                    <input type="search" class="setting-filter-input" placeholder="Filter optimisations" aria-label="Filter optimisations" spellcheck="false" autocomplete="off" autocapitalize="off">
                                    <span class="setting-filter-count" aria-live="polite"></span>
                                </div>
                                <p class="setting-filter-empty" hidden></p>
                                {% for category in categories %}
                                    {# `config.json`'s array order is the pipeline order, so the
                                       groups filter it rather than reordering it: within a
                                       category the plugins keep the order the worker runs them in. #}
                                    <details class="plugin-category" data-category="{{ category.id }}" {% if category.open %}open{% endif %}>
                                        <summary class="plugin-category-summary">
                                            <span class="plugin-category-name">{{ category.name }}</span>
                                            {# Collapsing a category takes its notices out of the
                                               accessibility tree with it, so the header says how many
                                               are in there. The icon is for the reader the tint on the
                                               count doesn't reach; the text goes into the summary's
                                               accessible name. Both are `Settings._renderNotes()`'s. #}
                                            <span class="plugin-category-notice" hidden>
                                                {% include "partials/icons/info.svg" %}
                                                <span class="plugin-category-notice-text"></span>
                                            </span>
                                            {# Filled by `Settings._updateCounts()`. #}
                                            <span class="plugin-category-count"></span>
                                        </summary>
                                        <div class="plugins">
                                            {% for plugin in plugins %}
                                                {% if plugin.category == category.id %}{{ pluginToggle(plugin) }}{% endif %}
                                            {% endfor %}
                                        </div>
                                    </details>
                                {% endfor %}
                            </section>
                        </div>
                        <div class="settings-panel" role="tabpanel" id="settings-panel-output" aria-labelledby="settings-tab-output" hidden>
                            <section>
                                <h1 class="settings-sub-heading">Output</h1>
                                <label class="setting-item-toggle">
                                    <input type="checkbox" name="gzip" checked>
                                    {% include "partials/material-switch.html" %}
                                    Compare gzipped
                                </label>
                                <label class="setting-item-toggle">
                                    <input type="checkbox" name="pretty">
                                    {% include "partials/material-switch.html" %}
                                    Prettify markup
                                </label>
                                <label class="setting-item-range">
                                    <span class="label-text">Number precision</span>
                                    <input type="range" min="0" max="8" step="1" value="3" name="floatPrecision">
                                </label>
                                <label class="setting-item-range">
                                    <span class="label-text">Transform precision</span>
                                    <input type="range" min="0" max="8" step="1" value="5" name="transformPrecision">
                                </label>
                                <label class="setting-item-select">
                                    <span class="label-text">Size attributes</span>
                                    <select name="dimensionAttrs">
                                        <option value="original" selected>Keep as they are</option>
                                        <option value="viewBox">viewBox only</option>
                                        <option value="widthHeight">width &amp; height only</option>
                                        <option value="both">Both</option>
                                    </select>
                                </label>
                                <label class="setting-item-select">
                                    <span class="label-text">IDs</span>
                                    <select name="ids">
                                        <option value="minify" selected>Shorten and drop unused</option>
                                        <option value="removeUnused">Drop unused only</option>
                                        <option value="keep">Keep as they are</option>
                                    </select>
                                </label>
                                <label class="setting-item-text">
                                    <span class="label-text">ID prefix</span>
                                    {# The pattern restates the worker's `idPrefixPattern` (id-prefix.js): what
                                       fails it is never applied, only flagged here. #}
                                    <input type="text" name="idPrefix" placeholder="none" spellcheck="false" autocomplete="off" autocapitalize="off" pattern="\s*[A-Za-z_](\w|-)*\s*" title="Letters, digits, hyphens and underscores; must not start with a digit or hyphen">
                                </label>
                                <label class="setting-item-select">
                                    <span class="label-text">Metadata</span>
                                    <select class="metadata-select">
                                        <option value="keep">Keep all</option>
                                        <option value="junk" selected>Drop junk, keep accessibility</option>
                                        <option value="all">Drop all</option>
                                        <option value="custom">Custom…</option>
                                    </select>
                                </label>
                                <div class="metadata-custom plugins" hidden>
                                    {% for plugin in plugins %}
                                        {% if plugin.metadata %}{{ pluginToggle(plugin) }}{% endif %}
                                    {% endfor %}
                                </div>
                                <label class="setting-item-select">
                                    <span class="label-text">Styles</span>
                                    <select class="styles-select">
                                        <option value="keep">Keep as they are</option>
                                        <option value="minify">Minify</option>
                                        <option value="inline" selected>Inline into elements</option>
                                        <option value="attributes">Convert to presentation attributes</option>
                                        {# Named after the one plugin it enables, not after what "styles"
                                           might sound like: `removeStyleElement` deletes `<style>`
                                           elements, and a `style` attribute on an element survives it. #}
                                        <option value="remove">Remove style elements</option>
                                        <option value="custom">Custom…</option>
                                    </select>
                                </label>
                                {# The `plugins` class is what keeps these checkboxes in
                                   `_pluginInputs`, and so in `getSettings().plugins`. #}
                                <div class="styles-custom plugins" hidden>
                                    {% for plugin in plugins %}
                                        {% if plugin.styles %}{{ pluginToggle(plugin) }}{% endif %}
                                    {% endfor %}
                                </div>
                                <label class="setting-item-toggle">
                                    <input type="checkbox" name="currentColor">
                                    {% include "partials/material-switch.html" %}
                                    Colours to currentColor
                                </label>
                            </section>
                        </div>
                    </div>
                    {# Below both panels rather than inside either: it resets everything,
                       so it has to be reachable from whichever tab is showing. #}
                    <div class="setting-reset-row">
                        {# The empty state carries this link too, but it is gone once a file is
                           open — and § 2(c) asks the app to say where its source is for as long
                           as it is running. This row sits outside .settings-scroller, so the
                           scroller's focus-cancelling mousedown never reaches the link. #}
                        <a class="setting-legal-link" href="notices.html">Licence and notices</a>
                        <button class="unbutton setting-reset" type="button">Reset all</button>
                    </div>
                </div>
            </div>
            <div class="preloader">
                <div class="spinner">
                    <div class="spinner-container">
                        <div class="spinner-layer">
                            <div class="circle-clipper left">
                                <div class="circle"></div>
                            </div>
                            <div class="gap-patch">
                                <div class="circle"></div>
                            </div>
                            <div class="circle-clipper right">
                                <div class="circle"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <p>Sorry, wasn't ready…</p>
            </div>
        </div>
    </body>
</html>
